---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allExperience = await getCollection('experience');
  return allExperience.map(experience => ({
    params: { slug: experience.slug },
    props: { experience },
  }));
}

const { experience } = Astro.props;
const { Content } = await experience.render();
const { company, role, duration, description, tags, link, github } = experience.data;
---

<Layout title={`${role} at ${company} | Steven Sung`} description={description}>
  <main class="pt-32 pb-section-v-padding px-gutter-mobile md:px-gutter-desktop max-w-container-max mx-auto animate-fade-in">
    
    <!-- Back Navigation -->
    <div class="mb-10">
      <a href="/" class="inline-flex items-center gap-2 text-text-secondary hover:text-primary transition-colors font-label-mono text-label-mono group">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Home
      </a>
    </div>

    <!-- Experience Header Info -->
    <header class="mb-14">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
        <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-text-primary font-light">{company}</h1>
        <span class="font-label-mono text-label-mono text-text-muted bg-[rgba(255,255,255,0.03)] px-4 py-2 rounded-full border border-glass-border/30 w-fit">{duration}</span>
      </div>
      <p class="text-xl md:text-2xl text-primary font-light mb-6">{role}</p>
      <p class="font-body-base text-body-base text-text-secondary max-w-3xl font-light mb-8">{description}</p>
      
      <div class="flex flex-wrap gap-2 mb-8">
        {tags.map((tag) => (
          <span class="font-label-mono text-label-mono bg-[rgba(255,255,255,0.05)] text-text-muted px-3 py-1 rounded-full font-normal">
            {tag}
          </span>
        ))}
      </div>

      <div class="flex gap-4">
        {link && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center electric-gradient text-white font-label-mono text-label-mono rounded-full px-6 py-2 hover:-translate-y-[3px] hover:shadow-[0_0_20px_rgba(79,70,229,0.5)] transition-all duration-300">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            Visit Website
          </a>
        )}
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-glass-surface backdrop-blur-md border border-glass-border text-white font-label-mono text-label-mono rounded-full px-6 py-2 hover:bg-[rgba(255,255,255,0.08)] transition-all duration-300">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            View Work Source
          </a>
        )}
      </div>
    </header>

    <!-- Main Project Content -->
    <article class="markdown-content bg-glass-surface backdrop-blur-md border border-glass-border rounded-xl p-6 md:p-card-padding text-text-secondary font-body-base font-light">
      <Content />
    </article>

  </main>
</Layout>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  /* Scoped styles for Markdown Content */
  .markdown-content h2 {
    @apply font-headline-md-mobile md:font-headline-md text-text-primary font-light mt-12 mb-6;
  }
  .markdown-content h2:first-child {
    @apply mt-0;
  }
  .markdown-content > *:last-child {
    @apply mb-0;
  }
  .markdown-content h3 {
    @apply text-2xl text-text-primary font-light mt-10 mb-4;
  }
  .markdown-content p {
    @apply mb-6 leading-relaxed;
  }
  .markdown-content ul, .markdown-content ol {
    @apply ml-6 mb-6 list-disc space-y-2;
  }
  .markdown-content a {
    @apply text-primary font-normal transition-colors border-b border-dashed border-[rgba(195,192,255,0.4)] pb-0.5 hover:text-secondary hover:border-[rgba(76,215,246,0.6)];
  }
  .markdown-content code {
    @apply font-label-mono bg-[rgba(255,255,255,0.05)] border border-glass-border rounded px-1.5 py-0.5 text-sm text-text-primary;
  }
  .markdown-content pre {
    @apply bg-[rgba(0,0,0,0.4)] border border-glass-border rounded-xl p-6 my-8 overflow-x-auto;
  }
  .markdown-content pre code {
    @apply bg-transparent border-none p-0 text-sm text-text-secondary;
  }
  .markdown-content blockquote {
    @apply border-l-4 border-primary pl-6 py-2 my-8 italic text-text-primary bg-[rgba(255,255,255,0.02)] rounded-r-lg;
  }
</style>
