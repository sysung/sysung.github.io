---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Fetch projects and sort by 'order' frontmatter field
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

// Color gradients for cards to cycle through
const gradients = [
  "from-[rgba(79,70,229,0.05)]",
  "from-[rgba(6,182,212,0.05)]"
];

const hoverBgs = [
  "group-hover:bg-[rgba(79,70,229,0.2)]",
  "group-hover:bg-[rgba(6,182,212,0.2)]"
];

const hoverTexts = [
  "group-hover:text-primary",
  "group-hover:text-secondary"
];
---

<Layout title="Steven Sung | Data Infrastructure & Engineering" description="Data Infrastructure & Engineering portfolio architecting resilient systems and high-frequency data pipelines.">
  <main class="pt-32 pb-section-v-padding px-gutter-mobile md:px-gutter-desktop max-w-container-max mx-auto">
    
    <!-- Hero Section -->
    <section class="mb-section-v-padding">
      <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-text-primary mb-4 font-light animate-fade-in">Steven Sung</h1>
      <p class="font-body-base text-body-base text-text-secondary max-w-2xl font-light animate-fade-in" style="animation-delay: 0.15s">
        Data Infrastructure &amp; Engineering. Architecting resilient systems and high-frequency data pipelines.
      </p>
    </section>

    <!-- Projects Section -->
    <section id="projects">
      <h2 class="font-headline-md-mobile md:font-headline-md text-headline-md-mobile md:text-headline-md text-primary mb-8 border-b border-glass-border pb-4 font-light animate-fade-in" style="animation-delay: 0.3s">Work Experience</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedProjects.map((project, index) => {
          const { title, description, tags, link, github } = project.data;
          
          const gradient = gradients[index % gradients.length];
          const hoverBg = hoverBgs[index % hoverBgs.length];
          const hoverText = hoverTexts[index % hoverTexts.length];

          return (
            <article class="bg-glass-surface backdrop-blur-md border border-glass-border rounded-xl p-card-padding glass-card-hover group relative overflow-hidden animate-fade-in" style={`animation-delay: ${0.4 + (index * 0.1)}s`}>
              <div class={`absolute inset-0 bg-gradient-to-br ${gradient} to-transparent opacity-0 group-hover:opacity-100 transition-opacity`}></div>
              
              <div class="relative z-10">
                <h3 class={`font-headline-md-mobile text-headline-md-mobile text-text-primary mb-2 ${hoverText} transition-colors font-light`}>
                  <a href={`/projects/${project.slug}/`} class="absolute inset-0 z-20"><span class="sr-only">{title}</span></a>
                  {title}
                </h3>
                
                <p class="font-body-sm text-body-sm text-text-secondary mb-6 font-light">{description}</p>
                
                <div class="flex flex-wrap gap-2 relative z-30">
                  {tags.map((tag) => (
                    <span class={`font-label-mono text-label-mono bg-[rgba(255,255,255,0.05)] text-text-muted px-3 py-1 rounded-full ${hoverBg} group-hover:text-white transition-all font-normal`}>
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="flex gap-4 mt-6 relative z-30">
                  {github && (
                    <a href={github} target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-white transition-colors" aria-label={`View ${title} on GitHub`}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                      </svg>
                    </a>
                  )}
                  {link && (
                    <a href={link} target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-white transition-colors" aria-label={`Visit ${title} Live`}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

  </main>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
</style>
