---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Fetch projects and sort by 'order' frontmatter field
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<Layout title="sysung | Developer Portfolio" description="A highly optimized, content-driven developer portfolio built with Astro and styled with beautiful, premium glassmorphism.">
  <main class="container">
    
    <!-- Hero Section -->
    <section class="hero section animate-fade-in">
      <div class="hero-grid">
        <div class="hero-text">
          <p class="hero-subtitle">Welcome to my space</p>
          <h1>Hi, I'm <span class="gradient-text">sysung</span></h1>
          <p class="hero-description text-secondary animate-fade-in animate-delay-1">
            I am a software engineer focused on crafting high-performance, elegant web applications. Specializing in modern development paradigms, clean architectures, and engaging user experiences.
          </p>
          <div class="btn-group animate-fade-in animate-delay-2">
            <a href="#projects" class="btn btn-primary">Explore Projects</a>
            <a href="#contact" class="btn btn-secondary">Get in Touch</a>
          </div>
        </div>
        <div class="animate-fade-in animate-delay-1" style="display: flex; justify-content: center;">
          <div class="hero-avatar">
            <div class="hero-avatar-inner">
              S
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="section">
      <h2 class="animate-fade-in">Featured Projects</h2>
      <p style="margin-bottom: 3rem; color: var(--text-secondary); max-width: 600px;" class="animate-fade-in animate-delay-1">
        A curated selection of tools and applications I've built. Update these instantly by editing the Markdown files in <code style="background-color: var(--card-bg); padding: 0.2rem 0.4rem; border-radius: 4px; border: 1px solid var(--card-border); font-size: 0.9em; font-family: monospace;">src/content/projects/</code>.
      </p>
      
      <div class="projects-grid">
        {sortedProjects.map((project, index) => {
          const { title, description, tags, link, github } = project.data;
          return (
            <article class={`project-card animate-fade-in animate-delay-${(index % 3) + 1}`}>
              <div class="project-header">
                <!-- Folder Icon representing dynamic item -->
                <div class="project-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                  </svg>
                </div>
                
                <div class="project-links">
                  {github && (
                    <a href={github} target="_blank" rel="noopener noreferrer" aria-label={`View ${title} on GitHub`}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                      </svg>
                    </a>
                  )}
                  {link && (
                    <a href={link} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${title} Live`}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
              
              <h3 class="project-title">{title}</h3>
              <p class="project-desc">{description}</p>
              
              <div class="project-tags">
                {tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="section" style="margin-bottom: 6rem;">
      <div class="contact-container animate-fade-in">
        <h2 class="contact-title gradient-text" style="display: block; width: fit-content; margin: 0 auto 1.5rem;">Let's Create Something Great</h2>
        <p class="contact-text">
          Whether you want to discuss a potential project, inquire about opportunities, or just say hello, my inbox is always open.
        </p>
        <div class="btn-group" style="justify-content: center;">
          <a href="mailto:sysung98@gmail.com" class="btn btn-primary">Say Hello</a>
        </div>
      </div>
    </section>

  </main>
</Layout>
